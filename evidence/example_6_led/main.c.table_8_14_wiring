#include <stdio.h>
#include "ls1b.h"
#include "mips.h"
#include "ls1b_gpio.h"
#include "ns16550.h"
#define LED_1 9
#define LED_2 11
#define LED_3 15
#define LED_4 17
/* LED_5..LED_8: GPIO 42..45 as in the board manual table 8.14 (guide listing: 20, 22, 6, 7);
   the LED board is wired that way (UART0 header: UART0_RX 42, TX 43, RTS 44, CTS 45) */
#define LED_5 42
#define LED_6 43
#define LED_7 44
#define LED_8 45
#define GPIO_OUT 0
#define MAX_SPEED 100
#define MIN_SPEED 1000
#define BUFFER_SIZE 32
//-------------------------------------------------------------------------------------------------
// Global variables
//-------------------------------------------------------------------------------------------------
int speed = 500;         // Initial speed of the running LED (ms)
int current_led = LED_1; // The currently lit LED
int is_running = 0;      // Running state of the running LED
char buffer_uart[BUFFER_SIZE];
//-------------------------------------------------------------------------------------------------
// GPIO initialization
//-------------------------------------------------------------------------------------------------
void gpio_init() {
// Initialize the LEDs as output mode
gpio_enable(LED_1, GPIO_OUT);
gpio_enable(LED_2, GPIO_OUT);
gpio_enable(LED_3, GPIO_OUT);
gpio_enable(LED_4, GPIO_OUT);
gpio_enable(LED_5, GPIO_OUT);
gpio_enable(LED_6, GPIO_OUT);
gpio_enable(LED_7, GPIO_OUT);
gpio_enable(LED_8, GPIO_OUT);
}
//-------------------------------------------------------------------------------------------------
// UART initialization
//-------------------------------------------------------------------------------------------------
void uart_init() {
ls1x_uart_init(devUART3, NULL);
ls1x_uart_open(devUART3, NULL);
}
//-------------------------------------------------------------------------------------------------
// Control the currently lit LED
//-------------------------------------------------------------------------------------------------
void led_on(int led) {
gpio_write(LED_1, 1);
gpio_write(LED_2, 1);
gpio_write(LED_3, 1);
gpio_write(LED_4, 1);
gpio_write(LED_5, 1);
gpio_write(LED_6, 1);
gpio_write(LED_7, 1);
gpio_write(LED_8, 1);
if (led != -1) {
gpio_write(led, 0); // Turn on the specified LED
}
}
//-------------------------------------------------------------------------------------------------
// Switch to the next LED
//-------------------------------------------------------------------------------------------------
void next_led() {
switch (current_led) {
case LED_1: current_led = LED_2; break;
case LED_2: current_led = LED_3; break;
case LED_3: current_led = LED_4; break;
case LED_4: current_led = LED_5; break;
case LED_5: current_led = LED_6; break;
case LED_6: current_led = LED_7; break;
case LED_7: current_led = LED_8; break;
case LED_8: current_led = LED_1; break;
default: current_led = LED_1; break;
}
}
//-------------------------------------------------------------------------------------------------
// Parse the serial-port command
//-------------------------------------------------------------------------------------------------
void parse_command(char *command) {
if (strncmp(command, "ON ", 3) == 0) {
int led_num = atoi(&command[3]);
if (led_num >= 1 && led_num <= 8) {
int led_pins[] = {LED_1, LED_2, LED_3, LED_4, LED_5, LED_6, LED_7, LED_8};
led_on(led_pins[led_num - 1]);
is_running = 0; // Stop the running LED
}
} else if (strcmp(command, "OFF") == 0) {
led_on(-1); // Turn off all LEDs
is_running = 0; // Stop the running LED
} else if (strncmp(command, "SPEED ", 6) == 0) {
int new_speed = atoi(&command[6]);
if (new_speed >= MAX_SPEED && new_speed <= MIN_SPEED) {
speed = new_speed;
}
} else if (strcmp(command, "START") == 0) {
is_running = 1; // Start the running LED
} else if (strcmp(command, "STOP") == 0) {
is_running = 0; // Stop the running LED
}
}
//-------------------------------------------------------------------------------------------------
// Main function
//-------------------------------------------------------------------------------------------------
int main(void) {
int bytes_read = 0;
int total_read = 0; // Total number of bytes read
ls1x_drv_init();         /* Initialize the device driver */
install_3th_libraries(); /* Install the third-party libraries */
gpio_init();
uart_init();
while (1) {
// Read a single byte
char byte;
bytes_read = ls1x_uart_read(devUART3, &byte, 1, 1);
if (bytes_read > 0) {
buffer_uart[total_read++] = byte;
// Check whether the command terminator is reached
if (byte == '\n' || byte == '\r') {
buffer_uart[total_read - 1] = '\0'; // Replace the terminator with the string terminator
parse_command(buffer_uart);
// Feedback the command execution status
ls1x_uart_write(devUART3, buffer_uart, total_read, NULL);
// Reset the buffer
total_read = 0;
}
// Prevent buffer overflow
if (total_read >= BUFFER_SIZE) {
total_read = 0; // Exceeds the buffer size, reset
}
}
// Running LED logic
if (is_running) {
led_on(current_led);
delay_ms(speed);
next_led();
}
}
return 0;
}
